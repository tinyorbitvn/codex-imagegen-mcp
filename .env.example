# Copy to .env and edit. Every value here has a working default, so an
# untouched copy brings the stack up on one machine.

# Image tag for both services. "latest" follows the newest release; pin a
# version (e.g. 0.3.0) for anything you care about.
IMAGE_TAG=latest

# Published ports on the host.
MCP_PORT=8080
S3_PORT=9000
S3_CONSOLE_PORT=9001

# Object storage. The defaults match the bundled MinIO; point them at a
# real S3 endpoint to keep images somewhere durable.
S3_BUCKET=tinyorbit-artifacts
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# The base URL handed back to MCP clients. It must be reachable from
# wherever the client runs, so it names the host, not the container.
# Change the port here too if you change S3_PORT.
S3_PUBLIC_BASE_URL=http://localhost:9000/tinyorbit-artifacts

# One Codex sign-in drives one Codex process; leave this at 1 unless you
# know the account tolerates concurrent sessions.
WORKER_CONCURRENCY=1
# A job is abandoned after this long. Image jobs normally take 30-140s.
JOB_TIMEOUT_SECONDS=900
# Codex keeps its own copy of every generated image; this is how long
# those copies are kept before the worker deletes them.
GENERATED_IMAGE_RETENTION_HOURS=24

# Queue depth before the MCP server starts rejecting new work.
QUEUE_LIMIT=64
# Per-caller hourly limits.
RATE_LIMIT_CREATE_IMAGE_PER_HOUR=10
RATE_LIMIT_EDIT_IMAGE_PER_HOUR=20
