# Copy to .env and edit. Every value here has a working default, so an
# untouched copy brings the stack up on one machine with nothing else
# running: no Redis, no object storage.

# Image tag. "latest" follows the newest release; pin a version for anything
# you care about.
IMAGE_TAG=latest

# Published port, and the URL handed back to MCP clients for a generated
# image. Change both together if 8080 is taken.
MCP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# all = MCP endpoint and image worker in one process. Use mcp and worker to
# split them across two deployments; that needs REDIS_URL and the S3_* block
# below, since two processes share neither memory nor a local disk.
ROLE=all

# Leave empty to keep the queue in memory.
REDIS_URL=

# Leave empty to store images on the artifacts volume and serve them from
# /artifacts. Fill these in to use object storage instead, in which case
# S3_PUBLIC_BASE_URL is the base of the URL clients are handed.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# One Codex sign-in drives one Codex process; leave this at 1 unless you
# know the account tolerates concurrent sessions.
WORKER_CONCURRENCY=1
# A job is abandoned after this long. Image jobs normally take 30-140s.
JOB_TIMEOUT_SECONDS=900
# Codex keeps its own copy of every generated image; this is how long those
# copies are kept before they are deleted.
GENERATED_IMAGE_RETENTION_HOURS=24

# Queue depth before new work is rejected.
QUEUE_LIMIT=64
# Per-caller hourly limits.
RATE_LIMIT_CREATE_IMAGE_PER_HOUR=10
RATE_LIMIT_EDIT_IMAGE_PER_HOUR=20
