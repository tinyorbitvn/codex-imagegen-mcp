{
  "name": "tinyorbit-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Nền tảng MCP sinh ảnh của TinyOrbit — workspace gốc",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0",
    "@types/express": "^4.17.21"
  }
}
